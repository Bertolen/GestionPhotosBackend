# Ignorer les fichiers inutiles pour le build Docker

# Fichiers Maven : multi-stage — le jar est construit par le stage builder,
# tout target/ est ignoré (plus d'exception !target/*.jar).
target/
.tmp/
*.jar
pom.xml.versionsBackup

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Git
.git/
.gitignore

# Documentation
*.md

# Logs
*.log

# Configuration locale (le fallback deploy.sh crée un .env : jamais dans l'image)
.env
.env.local
.env.*.local

# Fichiers temporaires
*.tmp
*.swp

# Docker
Dockerfile
docker-compose*
.dockerignore

# Java
*.class

# OS
.DS_Store
Thumbs.db
