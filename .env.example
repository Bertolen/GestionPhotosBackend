# Configuration du déploiement — valeurs réelles de la prod.
# Copiez ce fichier en .env et adaptez si besoin.

# Chemin des photos sur la Pi (hôte), monté dans le conteneur sur /data/photos.
# Variable d'exécution : le changer ne nécessite ni rebuild ni variable de CI.
# (APP_STORAGE_PATH, lui, est fixé dans docker-compose.yml.)
PHOTO_STORAGE_PATH=/mnt/disque/photo-storage

# Image backend utilisée par docker compose.
# Défaut local : image construite sur place (déploiement manuel de secours).
# La CI déploie l'image du Container Registry GitLab en surchargeant cette variable.
BACKEND_IMAGE=gestion-photos:latest

# --- Scripts de déploiement manuel de secours (deploy.sh / deploy.ps1) ---

# Nom et tag de l'image Docker locale
IMAGE_NAME=gestion-photos
IMAGE_TAG=latest

# Raspberry Pi (hostname résolu par le DNS de la box)
RASPBERRY_HOST=nuestra-traviesa
RASPBERRY_USER=bertolen
RASPBERRY_SSH_PORT=22

# Port du backend sur la Pi (8080 ; le frontend occupe le 80)
RASPBERRY_DOCKER_PORT=8080
